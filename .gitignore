# Compiled binaries
bin/
*.exe
*.out

# Auto-generated production deployment (written by deploy-production.sh)
deployments/deployment-production.yaml

# Local cluster tools (not part of the project)
minikube-*
kubectl
kind

# Logs
*.log

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

/vendor

# NOTE: vendor/ is intentionally NOT ignored.
# Committing vendor/ makes the project fully self-contained and buildable
# in air-gapped / offline environments without any internet access.
